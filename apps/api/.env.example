NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ledger:ledger_local@localhost:5432/ledger
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/backend/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=Daily Ledger <reminders@dailyledger.store>
# Explicit opt-in only; never activate client-selected paid plans in production.
BILLING_STUB_ENABLED=false
# Optional read-only AI: choose your provider, then enable in /admin/ai.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Optional verified USD pricing per million tokens; blank means no cost estimate.
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=

# Web Push: generate once with npx web-push generate-vapid-keys; keep private key on API/worker only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@dailyledger.store

# Dedicated admin frontend origin; exact HTTPS origin in production.
ADMIN_ORIGIN=http://localhost:3003

# Proxy hops in front of the API. 1 = Railway only. Use 2 when browsers reach the API through the Vercel /backend rewrite
# (recommended production topology) so rate limits use the real client IP instead of one shared Vercel IP.
TRUST_PROXY_HOPS=1
