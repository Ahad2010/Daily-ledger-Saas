{
  "name": "daily-ledger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:web": "npm run dev -w @ledger/web",
    "dev:api": "npm run dev -w @ledger/api",
    "build": "npm run build -w @ledger/web && npm run build -w @ledger/admin && npm run build -w @ledger/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests",
    "test": "tsx --test --test-concurrency=1 --import ./tests/support/clear-limits.mjs tests/*.test.ts",
    "db:generate": "npm run db:generate -w @ledger/api",
    "db:migrate": "npm run db:migrate -w @ledger/api",
    "worker": "npm run worker -w @ledger/api",
    "admin": "npm run admin -w @ledger/api --",
    "dev:admin": "npm run dev -w @ledger/admin"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.10.0",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.46.0",
    "@playwright/test": "^1.56.0"
  }
}
